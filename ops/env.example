# Environment for magnit pipeline on VPS. NEVER committed (see .gitignore).
# Fill once, installer never overwrites this file.
# T-invest OpenAPI token (market snapshot + consensus). Get: https://www.tbank.ru/investments/ (API token)
TINVEST_TOKEN=
# Cloudflare Pages deploy (dashboard refresh on VPS). Create: dash.cloudflare.com ->
# My Profile -> API Tokens -> Create (template "Edit Cloudflare Workers" is NOT enough;
# needs Account:Cloudflare Pages:Edit + Account:Account Settings:Read), then:
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional: Telegram alerts for failed runs (same bot as panels, see 839-data dash-alert)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
